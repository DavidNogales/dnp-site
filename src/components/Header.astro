---
import ThemeToggle from "./ThemeToggle.astro";
const links: Array<[string, string]> = [["/", "Home"], ["/blog", "Blog"], ["/projects", "Projects"], ["/about", "About"], ["/cv/", "CV"], ["/contact", "Contact"]];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isCurrent = (href: string) => href === "/" ? Astro.url.pathname === `${base}/` : Astro.url.pathname.startsWith(`${base}${href}`);
---
<header>
  <div class="container bar">
    <a class="brand" href={`${base}/`}>DNP</a>
    <nav aria-label="Main navigation"><ul>{links.map(([href, label]) => <li><a href={`${base}${href}`} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a></li>)}</ul></nav>
    <ThemeToggle />
  </div>
</header>
<style>
  header { border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 92%, transparent); }
  .bar { min-height: 4.5rem; display: flex; align-items: center; gap: 1rem; }
  .brand { font-weight: 900; text-decoration: none; color: var(--text); }
  nav { margin-left: auto; overflow-x: auto; }
  ul { display: flex; list-style: none; gap: 1rem; margin: 0; padding: .5rem; }
  nav a { color: var(--muted); text-decoration: none; white-space: nowrap; }
  nav a[aria-current="page"] { color: var(--accent); font-weight: 700; }
  @media (max-width: 44rem) { .bar { flex-wrap: wrap; padding-block: .7rem; } nav { order: 3; width: 100%; } ul { padding-left: 0; } }
</style>
