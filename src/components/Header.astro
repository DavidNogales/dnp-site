---
import ThemeToggle from "./ThemeToggle.astro";
import logoDarkUrl from "../assets/brand/rune-harp-dark.svg?url";
import logoLightUrl from "../assets/brand/rune-harp-light.svg?url";
const links: Array<[string, string]> = [["/", "Home"], ["/projects", "Projects"], ["/blog", "Blog"], ["/cv/", "CV"], ["/contact", "Contact"]];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isCurrent = (href: string) => href === "/" ? Astro.url.pathname === `${base}/` : Astro.url.pathname.startsWith(`${base}${href}`);
---
<header>
  <div class="container bar">
    <a class="brand" href={`${base}/`} aria-label="David Nogales Pérez home">
      <img class="logo-dark" src={logoDarkUrl} alt="" width="500" height="500" />
      <img class="logo-light" src={logoLightUrl} alt="" width="500" height="500" />
    </a>
    <nav aria-label="Main navigation"><ul>{links.map(([href, label]) => <li><a href={`${base}${href}`} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a></li>)}</ul></nav>
    <ThemeToggle />
  </div>
</header>
<style>
  header { background: var(--bg); }
  .bar { min-height: 4.75rem; display: flex; align-items: center; gap: 1.25rem; }
  .brand { display: grid; flex: none; width: 2.75rem; height: 2.75rem; place-items: center; }
  .brand img { grid-area: 1 / 1; display: block; width: 100%; height: 100%; }
  .logo-light { display: none; }
  :global(:root[data-theme="light"]) .logo-dark { display: none; }
  :global(:root[data-theme="light"]) .logo-light { display: block; }
  nav { margin-left: auto; overflow-x: auto; }
  ul { display: flex; list-style: none; gap: clamp(.75rem, 2.5vw, 1.4rem); margin: 0; padding: 0; }
  nav a { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-sm); font-weight: var(--weight-medium); text-decoration: none; white-space: nowrap; }
  nav a:hover { color: var(--text); }
  nav a[aria-current="page"] { color: var(--accent); text-decoration: underline; text-underline-offset: .35rem; }
  @media (max-width: 40rem) { .bar { flex-wrap: wrap; padding-block: 1rem; } nav { order: 3; width: 100%; } }
</style>
