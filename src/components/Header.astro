---
import ThemeToggle from "./ThemeToggle.astro";
import logoDarkUrl from "../assets/brand/rune-harp-dark.svg?url";
import logoLightUrl from "../assets/brand/rune-harp-light.svg?url";
const links: Array<[string, string]> = [["/", "Home"], ["/projects", "Projects"], ["/blog", "Blog"], ["/cv/", "CV"], ["/contact", "Contact"]];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isCurrent = (href: string) => href === "/" ? Astro.url.pathname === `${base}/` : Astro.url.pathname.startsWith(`${base}${href}`);
---
<header transition:name="sidebar" transition:animate="none">
  <div class="bar">
    <a class="brand" href={`${base}/`} aria-label="David Nogales Pérez home">
      <img class="logo-dark" src={logoDarkUrl} alt="" width="500" height="500" />
      <img class="logo-light" src={logoLightUrl} alt="" width="500" height="500" />
    </a>
    <nav aria-label="Main navigation">
      <ul>{links.map(([href, label]) =>
        <li><a href={`${base}${href}`} aria-current={isCurrent(href) ? "page" : undefined}>
          <span class="nav-label">
            {label}
            {isCurrent(href) && <span class="active-indicator" aria-hidden="true" />}
          </span>
        </a></li>
      )}</ul>
    </nav>
  </div>
  <div class="theme-corner">
    <ThemeToggle />
  </div>
</header>
<style>
  header { position: fixed; inset: 0 auto 0 0; display: flex; flex-direction: column; width: var(--sidebar-width); height: 100dvh; background: var(--bg); }
  .bar { display: flex; flex: 1; min-height: 0; overflow-y: auto; flex-direction: column; align-items: flex-start; gap: 2rem; padding: 2rem clamp(1rem, 3vw, 2.5rem); }
  .theme-corner { flex: none; padding: 1rem clamp(1rem, 3vw, 2.5rem) max(1.25rem, env(safe-area-inset-bottom)); }
  .brand { display: grid; flex: none; width: 2.75rem; height: 2.75rem; place-items: center; }
  .brand img { grid-area: 1 / 1; width: 100%; height: 100%; }
  .logo-dark { display: block; }
  .logo-light { display: none; }
  :global(:root[data-theme="light"]) .logo-dark { display: none; }
  :global(:root[data-theme="light"]) .logo-light { display: block; }
  nav { width: 100%; flex-shrink: 0; }
  ul { display: flex; flex-direction: column; list-style: none; gap: .25rem; margin: 0; padding: 0; }
  nav a { display: flex; align-items: center; min-height: 2.75rem; color: var(--muted); font-family: var(--font-mono); font-size: var(--text-sm); font-weight: var(--weight-medium); text-decoration: none; white-space: nowrap; }
  nav a:hover { color: var(--text); }
  nav a[aria-current="page"] { color: var(--accent); }
  .nav-label { position: relative; }
  .active-indicator { position: absolute; inset: auto 0 -.2rem; height: 1px; background: var(--accent); view-transition-name: nav-indicator; }
  :global(::view-transition-group(nav-indicator)) { animation-duration: 180ms; animation-timing-function: ease-in-out; }
  :global(::view-transition-old(nav-indicator)),
  :global(::view-transition-new(nav-indicator)) { animation: none; mix-blend-mode: normal; }
  :global(::view-transition-old(nav-indicator)) { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(::view-transition-group(nav-indicator)) { animation: none; }
  }
  @media (max-width: 40rem) {
    .bar { gap: 1.25rem; padding: 1.25rem 1rem; }
    .theme-corner { padding-inline: 1rem; }
  }
</style>
