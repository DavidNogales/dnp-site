---
import { resolveContactConfig } from "../lib/contact-config.mjs";
const config = resolveContactConfig(import.meta.env.PUBLIC_FORMSPREE_FORM_ID, import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---
{config ? (
  <form data-contact data-sitekey={config.siteKey} data-astro-reload action={config.endpoint} method="POST">
    <fieldset disabled>
    <legend class="sr-only">Contact message</legend>
    <label>Email address<input name="email" type="email" autocomplete="email" aria-describedby="contact-email-error" required /><span id="contact-email-error" data-field-error="email"></span></label>
    <label>Subject <span>(optional)</span><input name="subject" type="text" maxlength="120" aria-describedby="contact-subject-error" /><span id="contact-subject-error" data-field-error="subject"></span></label>
    <label>Message<textarea name="message" rows="7" aria-describedby="contact-message-error" required></textarea><span id="contact-message-error" data-field-error="message"></span></label>
    <input class="trap" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div data-verification hidden><div data-turnstile></div></div>
    <button class="button" type="submit">Send message</button>
    <button class="button" type="button" data-retry hidden>Retry verification</button>
    </fieldset>
    <p data-status role="status" aria-live="polite" aria-atomic="true">Preparing secure contact form…</p>
    <noscript><p>JavaScript is required for protected contact submission. Enable it to send a message without leaving this page.</p></noscript>
  </form>
) : <p class="notice" data-contact-unavailable>Contact form unavailable. Public form and verification configuration are required.</p>}
<script>
  import { initializeContact, disposeContact } from "../scripts/contact";
  initializeContact();
  document.addEventListener("astro:after-swap", initializeContact);
  document.addEventListener("astro:before-swap", disposeContact);
  window.addEventListener("pagehide", disposeContact);
  window.addEventListener("pageshow", initializeContact);
</script>
<style>
  form { max-width: var(--reading); }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; display: grid; gap: 1.35rem; }
  label { display: grid; gap: .4rem; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: var(--weight-medium); }
  label span { color: var(--muted); font-weight: var(--weight-regular); }
  input, textarea { width: 100%; color: var(--text); background: transparent; border: 1px solid var(--border); border-radius: 0; padding: .75rem; }
  input:focus, textarea:focus { border-color: var(--accent); }
  textarea { resize: vertical; }
  .trap { position: absolute; left: -10000px; }
  .notice { color: var(--muted); }
  [data-field-error]:empty { display: none; }
  [data-field-error] { font-weight: var(--weight-regular); }
  [data-verification] { min-height: 140px; }
  [hidden] { display: none; }
  [data-status] { min-height: 3.3em; margin-block: 1.35rem 0; color: var(--muted); }
  button:disabled { cursor: wait; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
