---
const formId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID?.trim();
---
{formId ? (
  <form data-contact data-astro-reload action={`https://formspree.io/f/${formId}`} method="POST">
    <label>Email address<input name="email" type="email" autocomplete="email" required /></label>
    <label>Subject <span>(optional)</span><input name="subject" type="text" maxlength="120" /></label>
    <label>Message<textarea name="message" rows="7" required></textarea></label>
    <input class="trap" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="button" type="submit">Send message</button>
    <p class="submission-note">Continue to Formspree to complete verification and send your message.</p>
  </form>
) : <p class="notice">Contact form not configured. Set <code>PUBLIC_FORMSPREE_FORM_ID</code> to enable it.</p>}
<style>
  form { max-width: var(--reading); display: grid; gap: 1.35rem; }
  label { display: grid; gap: .4rem; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: var(--weight-medium); }
  label span { color: var(--muted); font-weight: var(--weight-regular); }
  input, textarea { width: 100%; color: var(--text); background: transparent; border: 1px solid var(--border); border-radius: 0; padding: .75rem; }
  input:focus, textarea:focus { border-color: var(--accent); }
  textarea { resize: vertical; }
  .trap { position: absolute; left: -10000px; }
  .notice { color: var(--muted); }
  .submission-note { margin: 0; color: var(--muted); }
</style>
