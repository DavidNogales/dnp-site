---
import { readFile } from "node:fs/promises";
import { parse } from "yaml";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

interface Link { label: string; url: string; }
interface Education { institution: string; location: string; qualification: string; dates: string; }
interface Experience { role: string; location: string; company: string; dates: string; achievements: string[]; }
interface Skill { label: string; value: string; }
interface Project { name: string; url: string; technologies: string; description: string; }
interface CvData {
  profile: { name: string; location: string; contact: Link; github: Link };
  about: string;
  education: Education[];
  experience: Experience[];
  skills: Skill[];
  projects: Project[];
}

const cv = parse(await readFile(new URL("../../cv/data.yaml", import.meta.url), "utf8")) as CvData;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title={`CV · ${cv.profile.name}`} description={`Curriculum vitae for ${cv.profile.name}.`}>
  <section class="hero">
    <p class="eyebrow">Curriculum vitae</p>
    <h1>{cv.profile.name}</h1>
    <p class="lede">{cv.about}</p>
    <div class="profile-links">
      <span><Icon name="location" />{cv.profile.location}</span>
      <a href={`${base}/contact/`}><Icon name="contact" />{cv.profile.contact.label}</a>
      <a href={cv.profile.github.url} rel="noreferrer"><Icon name="github" />{cv.profile.github.label}</a>
    </div>
    <div class="actions"><a class="button" href={`${base}/cv/cv.pdf`}><Icon name="download" />Download PDF</a></div>
  </section>

  <section class="cv-section">
    <p class="eyebrow">Experience</p>
    <h2>Work history</h2>
    <div class="timeline">{cv.experience.map((item) =>
      <article class="card timeline-item">
        <div class="entry-heading"><div><h3>{item.role}</h3><p>{item.company}</p></div><p class="meta">{item.dates}<br />{item.location}</p></div>
        <ul>{item.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
      </article>
    )}</div>
  </section>

  <section class="cv-section">
    <p class="eyebrow">Background</p>
    <h2>Education</h2>
    <div class="grid">{cv.education.map((item) =>
      <article class="card education-card"><p class="meta">{item.dates}</p><h3>{item.institution}</h3><p>{item.qualification}</p><p class="meta"><Icon name="location" size={15} />{item.location}</p></article>
    )}</div>
  </section>

  <section class="cv-section">
    <p class="eyebrow">Toolbox</p>
    <h2>Skills</h2>
    <div class="skill-grid">{cv.skills.map((skill) =>
      <article class="skill-group"><h3>{skill.label.replace(/:$/, "")}</h3><p>{skill.value}</p></article>
    )}</div>
  </section>

  <section class="cv-section">
    <p class="eyebrow">Selected work</p>
    <h2>Projects</h2>
    <div class="grid">{cv.projects.map((project) =>
      <article class="card project-card"><p class="meta">{project.technologies}</p><h3><a href={project.url} rel="noreferrer"><Icon name="github" />{project.name}</a></h3><p>{project.description}</p></article>
    )}</div>
  </section>
</BaseLayout>

<style>
  .hero { max-width: 52rem; }
  .hero h1 { margin-bottom: 1rem; }
  .profile-links { display: flex; flex-wrap: wrap; gap: .65rem 1.25rem; margin-top: 1.5rem; color: var(--muted); }
  .profile-links :is(a, span), .button, .project-card a, .education-card .meta:last-child { display: inline-flex; align-items: center; gap: .45rem; }
  .profile-links a { color: var(--muted); }
  .cv-section { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .cv-section > h2 { margin: .25rem 0 1.25rem; font-size: clamp(1.7rem, 4vw, 2.35rem); }
  .timeline { display: grid; gap: 1rem; }
  .timeline-item { border-left: 3px solid var(--accent); }
  .entry-heading { display: flex; justify-content: space-between; gap: 1rem; }
  .entry-heading h3, .entry-heading p, .education-card p, .project-card p { margin-block: 0; }
  .entry-heading .meta { text-align: right; }
  .timeline-item ul { margin: 1rem 0 0; padding-left: 1.25rem; }
  .timeline-item li + li { margin-top: .5rem; }
  .education-card, .project-card { display: grid; align-content: start; gap: .6rem; }
  .skill-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); gap: .75rem; }
  .skill-group { padding: 1rem; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 var(--radius) var(--radius) 0; }
  .skill-group h3, .skill-group p { margin: 0; }
  .skill-group h3 { margin-bottom: .3rem; font-size: 1rem; }
  .project-card h3 { margin: 0; }
  .project-card a { color: var(--text); text-decoration: none; }
  .project-card a:hover { color: var(--accent); text-decoration: underline; }
  @media (max-width: 40rem) {
    .entry-heading { display: block; }
    .entry-heading .meta { margin-top: .5rem; text-align: left; }
  }
</style>
