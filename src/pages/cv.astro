---
import { readFile } from "node:fs/promises";
import { parse } from "yaml";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Link { label: string; url: string; }
interface Education { institution: string; location: string; qualification: string; dates: string; }
interface Experience { role: string; location: string; company: string; dates: string; achievements: string[]; }
interface Skill { label: string; value: string; }
interface Project { name: string; url: string; technologies: string; description: string; }
interface CvData {
  profile: { name: string; location: string; contact: Link; github: Link };
  about: string;
  education: Education[];
  experience: Experience[];
  skills: Skill[];
  projects: Project[];
}

const cv = parse(await readFile(new URL("../../cv/data.yaml", import.meta.url), "utf8")) as CvData;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title={`CV · ${cv.profile.name}`} description={`Curriculum vitae for ${cv.profile.name}.`}>
  <header class="cv-intro">
    <p class="eyebrow">Curriculum vitae</p>
    <h1>{cv.profile.name}</h1>
    <p class="lede">{cv.about}</p>
    <p class="meta">{cv.profile.location} · <a href={`${base}/contact/`}>{cv.profile.contact.label}</a> · <a href={cv.profile.github.url} rel="noreferrer">GitHub</a></p>
    <p class="download"><a href={`${base}/cv/cv.pdf`}>Download PDF ↓</a></p>
  </header>

  <section class="cv-section">
    <h2>Experience</h2>
    <div class="entries">{cv.experience.map((item) =>
      <article>
        <div class="entry-head"><div><h3>{item.role}</h3><p>{item.company}</p></div><p class="meta">{item.dates}<br />{item.location}</p></div>
        <ul>{item.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
      </article>
    )}</div>
  </section>

  <section class="cv-section">
    <h2>Education</h2>
    <div class="entries">{cv.education.map((item) =>
      <article class="entry-head"><div><h3>{item.institution}</h3><p>{item.qualification}</p></div><p class="meta">{item.dates}<br />{item.location}</p></article>
    )}</div>
  </section>

  <section class="cv-section">
    <h2>Skills</h2>
    <dl>{cv.skills.map((skill) => <><dt>{skill.label.replace(/:$/, "")}</dt><dd>{skill.value}</dd></>)}</dl>
  </section>

  <section class="cv-section">
    <h2>Projects</h2>
    <div class="entries">{cv.projects.map((project) =>
      <article><h3><a href={project.url} rel="noreferrer">{project.name} ↗</a></h3><p>{project.description}</p><p class="meta">{project.technologies}</p></article>
    )}</div>
  </section>
</BaseLayout>

<style>
  .cv-intro { max-width: var(--reading); margin-bottom: clamp(4rem, 10vw, 7rem); }
  .cv-intro .meta { margin-top: 1.75rem; }
  .cv-intro .meta a { color: var(--muted); }
  .download { margin-top: 1.5rem; }
  .download a { font-weight: var(--weight-semibold); text-decoration: none; }
  .cv-section { max-width: var(--reading); padding-block: 2.5rem; border-top: 1px solid var(--border); }
  .cv-section > h2 { margin-bottom: 2rem; }
  .entries { display: grid; gap: 2.25rem; }
  article p { margin: .25rem 0 0; }
  .entry-head { display: flex; justify-content: space-between; gap: 2rem; }
  .entry-head > .meta { flex: none; margin: 0; text-align: right; }
  ul { margin: 1rem 0 0; padding-left: 1.25rem; }
  li + li { margin-top: .6rem; }
  dl { display: grid; grid-template-columns: 10rem 1fr; gap: .7rem 1.5rem; margin: 0; }
  dt { font-weight: var(--weight-semibold); }
  dd { margin: 0; }
  .entries h3 a { color: var(--text); text-decoration: none; }
  .entries h3 a:hover { color: var(--accent); }
  @media (max-width: 38rem) {
    .entry-head { display: block; }
    .entry-head > .meta { margin-top: .5rem; text-align: left; }
    dl { grid-template-columns: 1fr; gap: .25rem; }
    dd { margin-bottom: .8rem; }
  }
</style>
