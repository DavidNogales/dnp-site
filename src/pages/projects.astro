---
import BaseLayout from "../layouts/BaseLayout.astro";
const projects = [
  { name: "DeepEarTraining", stack: "Python · PyTorch · FastAPI · Astro", href: "https://github.com/DavidNogales/DeepEarTraining", text: "On-demand melodic dictation exercises generated with deep learning. Bachelor's degree final project." },
  { name: "Logo3D", stack: "Python · ANTLR · VPython", href: "https://github.com/DavidNogales/Logo3D-LP-FIB", text: "An interpreter for a 3D version of Logo, designed to draw shapes from simple commands." },
  { name: "melody-generator", stack: "Music21 · TensorFlow · Keras", href: "https://github.com/DavidNogales/melody-generator", text: "A melody generator trained on the Bach chorales dataset." },
  { name: "clawdius-landing", stack: "HTML · CSS · Bootstrap", href: "https://github.com/DavidNogales/clawdius-landing", text: "A small responsive product landing page." },
];
---
<BaseLayout title="Projects · David Nogales Pérez" description="Selected software and music-technology projects.">
  <header class="page-intro"><p class="eyebrow">Selected work</p><h1>Projects</h1><p class="lede">Software, data, language tooling, and music technology.</p></header>
  <div class="project-list">{projects.map((project) => <article><h2><a href={project.href} rel="noreferrer">{project.name} ↗</a></h2><p>{project.text}</p><p class="meta">{project.stack}</p></article>)}</div>
</BaseLayout>
<style>
  .project-list { max-width: var(--reading); }
  article { padding-block: 1.75rem; border-bottom: 1px solid var(--border); }
  article:first-child { padding-top: 0; }
  h2 { font-size: var(--text-list-heading); }
  h2 a { color: var(--text); text-decoration: none; }
  h2 a:hover { color: var(--accent); }
  article p { margin: .45rem 0 0; }
  .meta { margin-top: .65rem; }
</style>
