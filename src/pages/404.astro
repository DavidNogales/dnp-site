---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Page not found · DNP" description="The requested page does not exist."><p class="eyebrow">404</p><h1>Page not found.</h1><p class="lede">The address may be old or mistyped.</p><a class="button" href={`${base}/`}>Return home</a></BaseLayout>
