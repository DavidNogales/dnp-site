---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="David Nogales Pérez · Software Engineer" description="Software engineer focused on backend systems, data engineering, automation, and reproducible infrastructure.">
  <section class="home-intro">
    <p class="eyebrow">Software Engineer · Barcelona</p>
    <h1>Building dependable systems and useful tools.</h1>
    <p class="lede">Backend development, data engineering, automation, and reproducible infrastructure.</p>
    <div class="text-links"><a href={`${base}/projects`}>Projects ↗</a><a href={`${base}/cv/`}>CV ↗</a></div>
  </section>
</BaseLayout>
<style>.home-intro { max-width: 45rem; padding-block: clamp(2rem, 8vw, 6rem) clamp(7rem, 20vw, 14rem); }</style>
