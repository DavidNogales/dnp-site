---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Blog · David Nogales Pérez" description="Technical notes about software, data, infrastructure, and music technology.">
  <header class="page-intro"><p class="eyebrow">Notes</p><h1>Blog</h1><p class="lede">Writing on software, data, infrastructure, and experiments.</p></header>
  <div class="archive">{posts.map((post) => <ArticleCard slug={post.id} {...post.data} />)}</div>
</BaseLayout>
<style>.archive { max-width: var(--reading); border-top: 1px solid var(--border); }</style>
