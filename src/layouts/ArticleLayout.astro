---
import BaseLayout from "./BaseLayout.astro";
const { title, description, published } = Astro.props;
---
<BaseLayout title={`${title} · DNP`} description={description}>
  <article class="prose">
    <p class="meta">{published.toLocaleDateString("en", { dateStyle: "long" })}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <slot />
  </article>
</BaseLayout>
<style>
  article > .meta { margin-bottom: 1rem; }
  article > .lede { margin-bottom: 3.5rem; }
</style>
