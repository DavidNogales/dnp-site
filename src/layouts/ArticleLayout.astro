---
import BaseLayout from "./BaseLayout.astro";
import katexStyles from "katex/dist/katex.min.css?inline";
const { title, description, published, hasMath = false } = Astro.props;
---
<BaseLayout title={`${title} · DNP`} description={description}>
  <Fragment slot="head">
    {hasMath && <style is:inline data-math="katex" set:html={katexStyles} />}
  </Fragment>
  <article class="prose">
    <p class="meta">{published.toLocaleDateString("en", { dateStyle: "long" })}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <slot />
  </article>
</BaseLayout>
<style>
  article > .meta { margin-bottom: 1rem; }
  article > .lede { margin-bottom: 3.5rem; }
</style>
