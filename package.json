{
  "name": "dnp-site",
  "private": true,
  "type": "module",
  "scripts": {
    "openspec": "OPENSPEC_TELEMETRY=0 openspec",
    "dev": "astro dev",
    "build:cv": "node scripts/build-cv.mjs",
    "build": "pnpm build:cv && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:loading": "node scripts/check-loading.mjs",
    "test:build": "node scripts/test-site.mjs build",
    "test:serve": "node scripts/test-site.mjs serve",
    "test:e2e": "pnpm test:build && playwright test",
    "test:perf": "node scripts/test-performance.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:version-builds": "node --test tests/build/build-version.test.mjs",
    "test:contact-builds": "node --test tests/build/contact-config.test.mjs",
    "test:social-builds": "node --test tests/build/social-preview.test.mjs",
    "test": "pnpm check && pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.16.3",
    "katex": "^0.16.25",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@fission-ai/openspec": "2.0.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.9.0"
}
